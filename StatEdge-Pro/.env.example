# StatEdge Pro - Environment Variables

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=your-secret-key-here

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=statedge_pro
DB_USER=postgres
DB_PASSWORD=your-password-here

# AI Models - NVIDIA API
NVIDIA_API_KEY=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
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_ID=nvidia/llama-3.1-nemotron-70b-instruct

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-password-here

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-email-password

# Analytics
ANALYTICS_MAX_CONCURRENT_REQUESTS=10
ANALYTICS_CACHE_TTL=300

# Data Feeds
DATA_FEED_TIMEOUT=30
DATA_FEED_RETRY_COUNT=3